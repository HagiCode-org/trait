{
  "name": "trait",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run prepare:i18n && node ./scripts/dev-server.mjs",
    "dev:static": "pnpm run prepare:i18n && node ./scripts/dev-server.mjs",
    "build": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; export NODE_ENV=\"${NODE_ENV:-production}\"; pnpm run prepare:i18n && pnpm run sync:agents && astro check && astro build && pnpm run seo:check && pnpm run size:check",
    "build:esa": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; export NODE_ENV=\"${NODE_ENV:-production}\"; pnpm run prepare:i18n && pnpm run sync:agents:build && astro check && astro build && pnpm run seo:check && pnpm run size:check",
    "lint": "eslint .",
    "preview": "astro preview",
    "sync:agents": "node ./scripts/sync-agents.mjs",
    "sync:agents:build": "node ./scripts/sync-agents.mjs --allow-stale-output",
    "sync:agents:dev": "node ./scripts/sync-agents.mjs --allow-stale-output",
    "sync:agents:update-source": "git submodule update --init --remote",
    "seo:check": "node ./scripts/check-seo.mjs",
    "size:check": "node ./scripts/check-size-budgets.mjs",
    "test": "pnpm run prepare:i18n && vitest run",
    "sync:agent-templates": "node ./scripts/generate-agent-templates.mjs",
    "i18n:audit": "hagi18n audit --config hagi18n.yaml",
    "i18n:report": "hagi18n report --config hagi18n.yaml",
    "i18n:doctor": "hagi18n doctor --config hagi18n.yaml",
    "i18n:sync": "hagi18n sync --config hagi18n.yaml --from en-US",
    "i18n:sync:write": "hagi18n sync --config hagi18n.yaml --from en-US --write",
    "i18n:prune": "hagi18n prune --config hagi18n.yaml --from en-US",
    "i18n:prune:write": "hagi18n prune --config hagi18n.yaml --from en-US --write",
    "i18n:generate": "node scripts/generate-i18n-resources.mjs",
    "prepare:i18n": "pnpm run i18n:generate",
    "i18n:check": "pnpm run i18n:audit && pnpm run i18n:doctor && pnpm run prepare:i18n && node scripts/generate-i18n-resources.mjs --check && vitest run scripts/__tests__/generate-i18n-resources.test.mjs src/components/site/site-links.test.ts",
    "check:registry": "node scripts/check-registry-neutrality.mjs",
    "test:registry": "node --test scripts/check-registry-neutrality.node-test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@hagicode/hagilight": "0.20.0",
    "@hagicode/hagilight-core": "0.20.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.1",
    "@hagicode/hagi18n": "^0.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
